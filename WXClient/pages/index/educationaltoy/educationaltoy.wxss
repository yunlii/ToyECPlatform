/* pages/index/educationaltoy/educationaltoy.wxss */
.educational-toy .container .page-body .page-section .banner-scroll swiper swiper-item image {
	width: 710rpx;
	height: 310rpx;
}

.educational-toy .container .page-body .page-section .education-navigation-bar {
	width: 686rpx;
	height: 180rpx;
	margin: auto;
	margin-top: 24rpx;
	border-radius: 4px;
	background-color: white;
	box-shadow: 0 2px 8px rgba(0, 0, 0, 8%);
	display: flex;
	justify-content: space-around;
	align-items: center;
}
.educational-toy .container .page-body .page-section .education-navigation-bar > view {
	display: flex;
	flex-direction: column;
	justify-content: center;
	align-items: center;
}
.educational-toy .container .page-body .page-section .education-navigation-bar > view .image {
	height: 80rpx;
}
.educational-toy .container .page-body .page-section .education-navigation-bar > view .image image {
	width: 80rpx;
	height: 80rpx;
}
.educational-toy .container .page-body .page-section .education-navigation-bar > view .name {
	font-size: 12px;
	color: #333333;
	line-height: 17px;
	margin-top: 16rpx;
}


.educational-toy .container .page-body .page-section .toy-classification {
	width: 686rpx;
	height: 88rpx;
	margin: auto;
	margin-top: 40rpx;
}
.educational-toy .container .page-body .page-section .toy-classification scroll-view {
	height: 88rpx;
	display: flex;
	flex-wrap: nowrap;
}
.educational-toy .container .page-body .page-section .toy-classification scroll-view .grade-item {
	margin-right: 48rpx;
}
.educational-toy .container .page-body .page-section .toy-classification scroll-view .grade-item view text {
	font-size: 14px;
	color: #999999;
	white-space: nowrap;
}
.educational-toy .container .page-body .page-section .toy-classification scroll-view .grade-item .grade {
	width: 96rpx;
	height: 36rpx;
	border-radius: 9px;
	background-color: #FFC45B;
	text-align: center;
	line-height: 36rpx;
	margin-top: 10rpx;
}
.educational-toy .container .page-body .page-section .toy-classification scroll-view .selected-item view text{
	font-size: 14px;
	color: #101010;
}


.educational-toy .container .page-body .page-section .product-bar-list {
	width: 100%;
	background-color: white;
	border-radius: 8px 8px 0 0;
	margin-top: 18rpx;
  padding-top: 20rpx;
}
.educational-toy .container .page-body .page-section .product-bar-list .empty {
	padding: 20rpx 0;
	text-align: center;
	color: #999999;
	display: none;
}
.educational-toy .container .page-body .page-section .product-bar-list .product-item {
	padding: 20rpx;
	display: flex;
	position: relative;
}
.educational-toy .container .page-body .page-section .product-bar-list .product-item .product-image {
  height: 200rpx;
}
.educational-toy .container .page-body .page-section .product-bar-list .product-item .product-image image {
	width: 200rpx;
	height: 200rpx;
}
.educational-toy .container .page-body .page-section .product-bar-list .product-item .product-info {
  margin-left: 32rpx;
}
.educational-toy .container .page-body .page-section .product-bar-list .product-item .product-info .product-name {
	font-size: 14px;
  color: #101010;
}
.educational-toy .container .page-body .page-section .product-bar-list .product-item .product-info .purchase-quantity {
	font-size: 14px;
	margin-top: 16rpx;
  color: #999999;
}
.educational-toy .container .page-body .page-section .product-bar-list .product-item .product-info .discounts {
	width: 140rpx;
	height: 32rpx;
	margin-top: 14rpx;
	border-radius: 4px;
	background-color: #FFC45B;
	font-size: 10px;
	text-align: center;
	line-height: 32rpx;
}
.educational-toy .container .page-body .page-section .product-bar-list .product-item .product-info .product-price {
	display: flex;
	margin-top: 16rpx;
}
.educational-toy .container .page-body .page-section .product-bar-list .product-item .product-info .product-price .discounted-price {
	font-size: 14px;
	color: #FFA911;
}
.educational-toy .container .page-body .page-section .product-bar-list .product-item .product-info .product-price .price {
	font-size: 14px;
	margin-left: 26rpx;
	color: #999999;
	background-image: linear-gradient(to right, transparent 0% 10%, #999999 0% 100%);
  background-size: 100% 1px;
  background-position: center; 
  background-repeat: no-repeat;
}
.educational-toy .container .page-body .page-section .product-bar-list .product-item .buy-button {
	width: 130rpx;
	height: 56rpx;
	border-radius: 14px;
	background-color: #FFC45B;
	font-size: 12px;
	color: #101010;
	text-align: center;
	line-height: 56rpx;
	position: absolute;
	right: 20rpx;
	bottom: 20rpx;
}