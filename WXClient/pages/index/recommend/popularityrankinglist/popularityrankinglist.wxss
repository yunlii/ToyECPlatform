/* pages/index/recommend/popularityrankinglist/popularityrankinglist.wxss */
.popularity-ranking-list {
	height: 100vh;
	padding-top: 260rpx;
	box-sizing: border-box;
	background-color: white;
}
.popularity-ranking-list .container .page-body .background {
	width: 100%;
	position: fixed;
	top: 0;
	left: 0;
}
.popularity-ranking-list .container .page-body .background image {
	width: 100%;
}


.popularity-ranking-list .container .page-body .goods-ranking-area {
	width: 100%;
	padding: 0 36rpx;
	box-sizing: border-box;
	padding-top: 40rpx;
	border-radius: 8px 8px 0 0;
	position: relative;
	z-index: 9999;
	background-color: white;
}


.popularity-ranking-list .container .page-body .goods-ranking-area .switch-component {
	display: flex;
	justify-content: left;
	align-items: center;
}
.popularity-ranking-list .container .page-body .goods-ranking-area .switch-component > view {
	position: relative;
	margin-right: 56rpx;
}
.popularity-ranking-list .container .page-body .goods-ranking-area .switch-component > view .list-name {
	font-size: 16px;
	color: #999999;
	margin: 0 6rpx;
	position: relative;
	z-index: 1;
}
.popularity-ranking-list .container .page-body .goods-ranking-area .switch-component > view .bar {
	width: 100%;
	height: 12rpx;
	position: absolute;
	top: 10rpx;
	right: 0;
	z-index: 0;
}
.popularity-ranking-list .container .page-body .goods-ranking-area .switch-component > view .bar image {
	width: 100%;
	height: 12rpx;
	bottom: 0;
}
.popularity-ranking-list .container .page-body .goods-ranking-area .switch-component .selected-list .list-name > text {
	font-size: 16px;
	color: #333333;
	font-weight: 700;
}


.popularity-ranking-list .container .page-body .goods-ranking-area .none {
	width: 100%;
	height: 50rpx;
	color: #999999;
	padding: 40rpx;
	text-align: center;
	line-height: 50rpx;
}