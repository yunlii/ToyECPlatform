/* pages/index/recommend/secondhandgoods/secondhandgoods.wxss */
.secondhand-goods .container .page-body .background {
	width: 100%;
	position: fixed;
	top: 0;
	left: 0;
	z-index: -1;
}
.secondhand-goods .container .page-body .background image {
	width: 100%;
}


.secondhand-goods .container .page-body .page-section .recommend-card {
	width: 686rpx;
	height: 348rpx;
	margin: 270rpx auto 0 auto;
	background-color: white;
	border-radius: 4px;
	box-shadow: 0px 4px 8px 0px rgba(0, 0, 0, 8%);
	display: flex;
	flex-direction: column;
	align-items: center;
	position: relative;
}
.secondhand-goods .container .page-body .page-section .recommend-card .recommend-card-title {
  	margin: 32rpx;
  	align-self: flex-start;
  	font-size: 16px;
  	font-weight: 700;
  }
	.secondhand-goods .container .page-body .page-section .recommend-card .recommend-card-list {
  	width: 622rpx;
  	display: flex;
  	flex-direction: column;
  	justify-content: center;
  	align-items: center;
  	position: relative;
  }
.secondhand-goods .container .page-body .page-section .recommend-card .product-info {
  	width: 622rpx;
  	height: 200rpx;
  	border-radius: 4px;
  	border: 1px solid #e5e5e5;
  	background-color: white;
  	padding: 24rpx;
  	box-sizing: border-box;
  	display: flex;
  	justify-content: space-around;
  	align-items: center;
  	z-index: 9;
	}
	.secondhand-goods .container .page-body .page-section .recommend-card .card-two {
  	width: 594rpx;
  	height: 200rpx;
  	position: absolute;
  	top: 8rpx;
  	z-index: 2;
  }
	.secondhand-goods .container .page-body .page-section .recommend-card .card-three {
  	width: 560rpx;
  	height: 188rpxs;
  	position: absolute;
  	top: 16rpx;
  	z-index: 1;
  }
	.secondhand-goods .container .page-body .page-section .recommend-card .product-info .product-introduce text {
  	font-size: 14px;
  }
	.secondhand-goods .container .page-body .page-section .recommend-card .product-info .product-introduce .product-price {
  	margin-top: 16rpx;
  }
	.secondhand-goods .container .page-body .page-section .recommend-card .product-info .product-introduce .product-price .discounted-price {
    color: #FFA911;
  }
	.secondhand-goods .container .page-body .page-section .recommend-card .product-info .product-introduce .product-price .price {
  	background-image: linear-gradient(to right, transparent 0% 10%, black 0% 100%);
    background-size: 100% 1px; /* 横线的厚度 */
    background-position: center; /* 横线居中 */
    background-repeat: no-repeat;
  }
	.secondhand-goods .container .page-body .page-section .recommend-card .product-info .discounts {
  	width: 140rpx;
  	height: 32rpx;
  	background-color: rgb(255, 196, 91);
  	border-radius: 4px;
  	text-align: center;
  	line-height: 32rpx;
  	font-size: 12px;
  	margin-top: 14rpx;
  }
	.secondhand-goods .container .page-body .page-section .recommend-card .product-info .discounts text {
  	font-size: 12px;
  }
	.secondhand-goods .container .page-body .page-section .recommend-card .product-info .product-image image {
  	width: 128rpx;
  	height: 128rpx;
  }
	.secondhand-goods .container .page-body .page-section .recommend-card .card-top {
  	width: 100%;
  	padding: 32rpx 0 0 32rpx;
  	display: flex;
  	justify-content: left;
  	box-sizing: border-box;
  }
	.secondhand-goods .container .page-body .page-section .recommend-card .card-top .card-title {
  	font-size: 16px;
  	font-weight: 700;
  }
	.secondhand-goods .container .page-body .page-section .recommend-card .product-list {
  	width: 100%;
  	padding: 0 30rpx;
  	margin-top: 24rpx;
  	box-sizing: border-box;
  }
	.secondhand-goods .container .page-body .page-section .recommend-card .scroll-bar{
  	width: 100%;
  	height: 218rpx; 
  	display: flex; 
    flex-direction: row;
  }
	.secondhand-goods .container .page-body .page-section .recommend-card .product-list .product-item {
  	margin-right: 80rpx;
  	display: flex;
  	flex-direction: column;
  	justify-content: center;
  	align-items: center;
  }
	.secondhand-goods .container .page-body .page-section .recommend-card .product-list .product-item image {
  	width: 120rpx;
  	height: 120rpx;
  }
	.secondhand-goods .container .page-body .page-section .recommend-card .product-list .product-item .product-title {
  	font-size: 14px;
  	margin-top: 10rpx;
  }
	.secondhand-goods .container .page-body .page-section .recommend-card .product-list .product-item .product-price {
  	font-size: 12px;
  	margin-top: 10rpx;
  }
	.secondhand-goods .container .page-body .page-section .recommend-card .product-list .product-item .discounted-price {
  	color: #FEA913;
  }
	.secondhand-goods .container .page-body .page-section .recommend-card .product-list .product-item .product-price .price {
  	background: linear-gradient(to right, black 0% 100%);
  	background-size: 100% 1px;
    background-position: center;
  	background-repeat: no-repeat;
  	margin-left: 10rpx;
  }


.secondhand-goods .container .page-body .page-section .card-list {
	margin: 0 32rpx;
	margin-top: 32rpx;
	display: flex;
	flex-wrap: wrap;
	justify-content: space-between;
}