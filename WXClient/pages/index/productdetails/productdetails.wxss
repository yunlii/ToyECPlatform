/* pages/index/productdetails/productdetails.wxss */
.product-details .container .page-body {
	height: 100vh;
	background-color: white;
	padding-top: 450rpx;
	box-sizing: border-box;
	position: relative;
	z-index: 0;
}
.product-details .container .page-body .page-section .product-image-swiper {
	width: 100%;
	position: fixed;
	top: 0;
	right: 0;
	z-index: -1;
}
.product-details .container .page-body .page-section .product-image-swiper swiper {
	width: 100%;
	height: 50vh;
}
.product-details .container .page-body .page-section .product-image-swiper .product-image image {
	width: 100%;
}


.product-details .container .page-body .page-section .product-show-area {
	border-radius: 8px 8px 0 0;
	background-color: white;
	padding: 0 32rpx;
}
.product-details .container .page-body .page-section .product-show-area .none {
	font-size: 18px;
	text-align: center;
	font-weight: 700;
	padding-top: 30rpx;
	display: none;
}
.product-details .container .page-body .page-section .product-show-area .product-name {
	font-size: 16px;
	color: #101010;
	font-weight: 700;
	padding-top: 42rpx;
}
.product-details .container .page-body .page-section .product-show-area .price-and-quantity {
	margin-top: 20rpx;
	display: flex;
}
.product-details .container .page-body .page-section .product-show-area .price-and-quantity .price {
	font-size: 14px;
	color: #FFA911;
}
.product-details .container .page-body .page-section .product-show-area .price-and-quantity .sale-quantity {
	font-size: 14px;
	color: #999999;
	margin-left: 30rpx;
}
.product-details .container .page-body .page-section .product-show-area .recommend {
	width: 686rpx;
	height: 200rpx;
	padding: 45rpx 24rpx;
	box-sizing: border-box;
	border-radius: 4px;
	background-color: #F5F5F5;
}
.product-details .container .page-body .page-section .product-show-area .recommend .text-area {
	font-size: 14px;
	color: #666666;
}
.product-details .container .page-body .page-section .product-show-area .recommend .text-area textarea {
	width: 634rpx;
	height: 96rpx;
}
.product-details .container .page-body .page-section .product-show-area .recommend .score {
	margin-top: 16rpx;
	display: flex;
	justify-content: space-between;
	align-items: center;
}
.product-details .container .page-body .page-section .product-show-area .recommend .score .score-icon {
	display: flex;
}
.product-details .container .page-body .page-section .product-show-area .recommend .score .score-icon > view {
	height: 28rpx;
	margin-right: 10rpx;
}
.product-details .container .page-body .page-section .product-show-area .recommend .score .score-icon image{
	width: 28rpx;
	height: 28rpx;
}
.product-details .container .page-body .page-section .product-show-area .recommend .score .score-text {
	font-size: 12px;
	color: #999999;
}
.product-details .container .page-body .page-section .product-show-area .product-brand {
	width: 686rpx;
	height: 120rpx;
	margin-top: 32rpx;
	padding: 0 24rpx;
	box-sizing: border-box;
	display: flex;
	justify-content: space-between;
	align-items: center;
	background-color: white;
	box-shadow: 0 4rpx 8px 0 rgba(0, 0, 0, 6%);
}
.product-details .container .page-body .page-section .product-show-area .product-brand .brand-info {
	display: flex;
	justify-content: left;
	align-items: center;
}
.product-details .container .page-body .page-section .product-show-area .product-brand .brand-info .brand-image {
	height: 80rpx;
}
.product-details .container .page-body .page-section .product-show-area .product-brand .brand-info .brand-image image {
	width: 80rpx;
	height: 80rpx;
}
.product-details .container .page-body .page-section .product-show-area .product-brand .brand-info .brand-name {
	font-size: 14px;
	color: #333333;
	margin-left: 24rpx;
}
.product-details .container .page-body .page-section .product-show-area .product-brand .brand-page-button {
	width: 130rpx;
	height: 56rpx;
	font-size: 12px;
	color: #101010;
	text-align: center;
	line-height: 56rpx;
	border-radius: 14px;
	background-color: #FFC45B;
}
.product-details .container .page-body .page-section .product-show-area .player-show .area-name {
	font-size: 16px;
	color: #333333;
	font-weight: 700;
}
.product-details .container .page-body .page-section .product-show-area .player-show {
	margin-top: 40rpx;
}
.product-details .container .page-body .page-section .product-show-area .player-show .image-list {
	margin-top: 30rpx;
	display: flex;
	flex-wrap: wrap;
	justify-content: space-between;
}
.product-details .container .page-body .page-section .product-show-area .player-show .image-list > view {
	height: 326rpx;
	margin-bottom: 30rpx;
}
.product-details .container .page-body .page-section .product-show-area .player-show .image-list > view image {
	width: 326rpx;
	height: 326rpx;
}



.product-details .container .page-body .page-section .product-show-area .recommended-toys .area-name {
	font-size: 16px;
	color: #333333;
	font-weight: 700;
}
.product-details .container .page-body .page-section .product-show-area .recommended-toys {
	margin-top: 15rpx;
}
.product-details .container .page-body .page-section .product-show-area .recommended-toys .image-list {
	margin-top: 30rpx;
	display: flex;
	flex-wrap: wrap;
	justify-content: space-between;
}
.product-details .container .page-body .page-section .product-show-area .recommended-toys .image-list > view {
	height: 326rpx;
	margin-bottom: 30rpx;
}
.product-details .container .page-body .page-section .product-show-area .recommended-toys .image-list > view image {
	width: 326rpx;
	height: 326rpx;
}