/* pages/wishlist/wishlist.wxss */
.wishlist .container .page-body .wish-card-box {
	padding: 0rpx 28rpx 0rpx 28rpx;
}


.wishlist .container .page-body .wish-card-box .empty-box {
	display: flex;
	flex-direction: column;
	justify-content: center;
	align-items: center;
	position: absolute;
	top: 50%;
	left: 50%;
	transform: translate(-50%, -50%);
	z-index: 999;
}
.wishlist .container .page-body .wish-card-box .empty-box .box-image {
	width: 126rpx;
	height: 144rpx;
}
.wishlist .container .page-body .wish-card-box .empty-box .box-image image{
	width: 126rpx;
	height: 144rpx;
}
.wishlist .container .page-body .wish-card-box .empty-box .box-text-wrap {
	display: flex;
	flex-direction: column;
	justify-content: center;
	align-items: center;
	margin-top: 60rpx;
}
.wishlist .container .page-body .wish-card-box .empty-box .box-text-wrap .box-title text {
	font-size: 16px;
	color: #333333;
	font-weight: 700;
	line-height: 22px;
}
.wishlist .container .page-body .wish-card-box .empty-box .box-text-wrap .box-text {
	font-size: 12px;
	color: #999999;
	line-height: 17px;
	margin-top: 12rpx;
}
.wishlist .container .page-body .wish-card-box .empty-box .box-button {
	width: 172rpx;
	height: 72rpx;
	margin-top: 32rpx;
	background-color: #FFC45B;
	border-radius: 18px;
	text-align: center;
	line-height: 72rpx;
	font-size: 14px;
	color: #101010;
}


.wishlist .container .page-body .wish-card-box  .share-button {
	height: 96rpx;
	position: fixed;
	z-index: 999;
	right: 30rpx;
	bottom: 40rpx;
}
.wishlist .container .page-body .wish-card-box  .share-button image {
	width: 96rpx;
	height: 96rpx;
}

.wishlist .container .page-body .wish-card-box scroll-view {
	height: 100vh;
}
.wishlist .container .page-body .wish-card-box scroll-view .wish-card-list {
	display: flex;
	flex-wrap: wrap;
	justify-content: space-between;
	padding-top: 32rpx;
}
.wishlist .container .page-body .wish-card-box scroll-view .wish-card {
	width: 326rpx;
	height: 514rpx;
	border-radius: 4px;
	background-color: #ffffff;
	box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 8%);
	margin-bottom: 32rpx;
}
.wishlist .container .page-body .wish-card-box scroll-view .wish-card .card-image {
	height: 326rpx;
}
.wishlist .container .page-body .wish-card-box scroll-view .wish-card .card-image image {
	width: 326rpx;
	height: 326rpx;
}
.wishlist .container .page-body .wish-card-box scroll-view .wish-card .card-info {
	padding: 0 18rpx;
}
.wishlist .container .page-body .wish-card-box scroll-view .wish-card .card-info .card-title {
	font-size: 14px;
	color: #101010;
	margin-top: 16rpx;
}
.wishlist .container .page-body .wish-card-box scroll-view .wish-card .card-info .product-price {
	font-size: 14px;
	color: #FFA911;
	margin-top: 14rpx;
}
.wishlist .container .page-body .wish-card-box scroll-view .wish-card .card-info .product-popularity {
	font-size: 14px;
	color: #999999;
	margin-top: 14rpx;
	line-height: 20px;
}


.wishlist .container .page-body .share-products {
	width: 100%;
	height: 100%;
	position: absolute;
	top: 0;
	left: 0;
	z-index: 9999;
}
.wishlist .container .page-body .share-products .background {
	width: 100%;
	height: 100%;
	position: absolute;
	background-color: rgba(0, 0, 0, 61%);
}
.wishlist .container .page-body .share-products .product-card {
	position: relative;
	width: 560rpx;
	/* height: 720rpx; */
	border-radius: 4px;
	background-color: white;
	top: 50%;
	left: 50%;
	transform: translate(-50%, -50%);
}
.wishlist .container .page-body .share-products .product-card .card-top {
	display: flex;
	padding: 32rpx 24rpx;
	justify-content: left;
	align-items: center;
}
.wishlist .container .page-body .share-products .product-card .card-top .profile-info {
	margin-left: 24rpx;
}
.wishlist .container .page-body .share-products .product-card .card-top .profile-info .card-title {
	font-size: 14px;
  color: #333333;
}
.wishlist .container .page-body .share-products .product-card .card-top .profile-info .card-text {
	font-size: 12px;
	color: #999999;
	margin-top: 8rpx;
}
.wishlist .container .page-body .share-products .product-card .card-top .avatar {
	height: 80rpx;
}
.wishlist .container .page-body .share-products .product-card .card-top .avatar image {
	width: 80rpx;
	height: 80rpx;
}
.wishlist .container .page-body .share-products .product-card .card-middle image {
	width: 560rpx;
	/* height: 446rpx; */
}
.wishlist .container .page-body .share-products .product-card .card-bottom {
	padding: 26rpx 24rpx;
	display: flex;
	justify-content: space-between;
	align-items: center;
}
.wishlist .container .page-body .share-products .product-card .card-bottom .card-redirect {
	display: flex;
	justify-content: left;
	align-items: center;
}
.wishlist .container .page-body .share-products .product-card .card-bottom .card-redirect .redirect-text {
	font-size: 14px;
  color: #333333;
}
.wishlist .container .page-body .share-products .product-card .card-bottom .card-redirect .redirect-icon {
	height: 28rpx;
	margin-left: 14rpx;
	text-align: center;
	line-height: 28rpx;
}
.wishlist .container .page-body .share-products .product-card .card-bottom .card-redirect .redirect-icon image {
	width: 28rpx;
	height: 28rpx;
}
.wishlist .container .page-body .share-products .product-card .card-bottom .qccode-image {
	height: 80rpx;
}
.wishlist .container .page-body .share-products .product-card .card-bottom .qccode-image image {
	width: 80rpx;
	height: 80rpx;
}


.wishlist .container .page-body .share-products .share-bar {
	 width: 750rpx;
	 height: 160rpx;
	 border-radius: 8px 8px 0 0;
	 display: flex;
	 background-color: white;
	 justify-content: space-around;
	 align-items: center;
	 position: absolute;
	 bottom: 0;
	 left: 0;
}
.wishlist .container .page-body .share-products .save-poster,
.wishlist .container .page-body .share-products .share-to-friend,
.wishlist .container .page-body .share-products .share-to-friend-circle {
	display: flex;
	flex-direction: column;
	justify-content: space-around;
	align-items: center;
}
.wishlist .container .page-body .share-products .save-poster .save-poster-icon,
.wishlist .container .page-body .share-products .share-to-friend .share-icon,
.wishlist .container .page-body .share-products .share-to-friend-circle .share-icon {
	height: 56rpx;
} 
.wishlist .container .page-body .share-products .save-poster .save-poster-icon image,
.wishlist .container .page-body .share-products .share-to-friend-circle .share-icon image {
	width: 56rpx;
	height: 56rpx;
}
.wishlist .container .page-body .share-products .share-to-friend .share-icon image {
	width: 68rpx;
	height: 56rpx;
}
.wishlist .container .page-body .share-products .save-poster .save-poster-text,
.wishlist .container .page-body .share-products .share-to-friend .share-text, 
.wishlist .container .page-body .share-products .share-to-friend-circle .share-text {
	font-size: 12px;
	color: #999999;
	line-height: 17px;
	margin-top: 24rpx;
}