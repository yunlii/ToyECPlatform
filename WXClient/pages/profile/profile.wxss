/* pages/profile/profile.wxss */
.profile-page > .container {
  height: 100vh;
  background-color: white;
}
.profile-page > .container scroll-view {
  height: 100vh;
}
.profile-page .container .page-section .background-image {
	width: 100%; 
	height: 300rpx;
}
.profile-page .container .page-section .background-image image {
	width: 100%; 
  height: 100%;
}


.profile-page .container .personal-container{
	background-color: white;
  padding: 0 32rpx;
}
.profile-page .container .personal-container .personal-info {
  margin-top: 32rpx;
  position: relative;
}
.profile-page .container .personal-container .personal-info .name {
	font-size: 20px;
	color: #101010;
	font-weight: 700;
	padding-top: 30rpx;
	padding-bottom: 20rpx;
}
.profile-page .container .personal-container .personal-info .brief-introduction {
	font-size: 14px;
	color: #999999;
}
.profile-page .container .personal-container .personal-info .follows-info {
	font-size: 14px;
	color: #333333;
}
.profile-page .container .personal-container .personal-info .follows-info {
	font-size: 14px;
	color: #333333;
	display: flex;
	margin-top: 26rpx;
}
.profile-page .container .personal-container .personal-info .follows-info .fans {
	margin-right: 40rpx;
}
.profile-page .container .personal-container .personal-info .avatar image {
	width: 192rpx;
	height: 192rpx;
	position: absolute;
	top: -36rpx;
	right: 10rpx;
}


.profile-page .container .page-section .dynamic-info .navigationbar-container {
  width: 100%;
  height: 102rpx;
  box-sizing: border-box;
}
.profile-page .container .page-section .dynamic-info  .navigationbar{
  margin-top: 50rpx;
  display: flex;
  flex-direction: row;
  justify-content: left;
  align-items: center;
  box-sizing: content-box;
}
.profile-page .container .page-section .dynamic-info  .navigationbar .item {
  margin-right: 100rpx;
  position: relative;
}
.profile-page .container .page-section .dynamic-info .navigationbar > view {
  position: absolute;
  z-index: 1;
}
.profile-page .container .page-section .dynamic-info .navigationbar view > text {
  font-size: 16px;
  color: #999999;
}
.profile-page .container .page-section .dynamic-info .navigationbar view .search-image {
  width: 90rpx;
  height: 56rpx;
}
.profile-page .container .page-section .dynamic-info .navigationbar .selected-item > text {
  color: #333333;
  font-weight: 700;
}
.profile-page .container .page-section .dynamic-info .navigationbar .selected-item > image {
  width: 100%;
  height: 12rpx;
  position: absolute;
  top: 30rpx;
  left: 0;
  z-index: -1;
}